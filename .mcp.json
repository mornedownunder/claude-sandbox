{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--headless",
        "--browser",
        "chrome"
      ]
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com?tools=actors,docs,apify/rag-web-browser"
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.2.1"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    }
  }
}
