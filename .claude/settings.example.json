{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": [
    "TEMPLATE — copy to .claude/settings.json and review before applying.",
    "Kept as an example on purpose: permission grants decide what an agent may",
    "do, so a human should be the one to apply them. Merge into an existing",
    "settings.json rather than overwriting it.",
    "The SessionStart hook is optional — it warns when the CLI is missing.",
    "Swap 'warn' for the installer if you want auto-install on session boot."
  ],
  "permissions": {
    "allow": [
      "Bash(scripts/agent-reach-preflight.sh)",
      "Bash(scripts/install-agent-reach.sh --dry-run)",
      "Bash(agent-reach doctor:*)",
      "Bash(agent-reach version:*)",
      "Bash(agent-reach check-update:*)",
      "Bash(agent-reach watch:*)",
      "Bash(agent-reach format:*)",
      "Bash(agent-reach install --env=auto)"
    ],
    "ask": [
      "Bash(scripts/install-agent-reach.sh:*)",
      "Bash(agent-reach configure:*)",
      "Bash(agent-reach setup:*)",
      "Bash(agent-reach skill:*)"
    ],
    "deny": [
      "Bash(agent-reach uninstall:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/agent-reach-preflight.sh || true"
          }
        ]
      }
    ]
  }
}
