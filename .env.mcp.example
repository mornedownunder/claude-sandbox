# Copy to .env.mcp, fill in, and source before launching Claude Code:
#   cp .env.mcp.example .env.mcp && $EDITOR .env.mcp && set -a && . ./.env.mcp && set +a
#
# .env.mcp is gitignored. Never commit real values.
# A token committed to git is compromised even after deletion — rotate it.

# --- Declared in .mcp.json ---
# Playwright — no credential.
# Apify — the hosted server uses OAuth and needs no token.
#         Only set this if you switch to the local stdio variant.
# APIFY_TOKEN=

# Perplexity — required. Key from https://console.perplexity.ai
# Use perplexity_search by default; perplexity_research is the expensive one.
PERPLEXITY_API_KEY=

# --- Not declared in .mcp.json. See docs/mcp/03-decision.md ---
# Buffer     — deferred until there is a social calendar to publish to.
#              Then add per-machine at --scope local. OAuth, no key.
# Higgsfield — rejected. Duplicates the ElevenLabs creative stack.
