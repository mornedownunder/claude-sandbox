# Copy to .env.mcp, fill in, and source it before launching Claude Code:
#   cp .env.mcp.example .env.mcp && $EDITOR .env.mcp && set -a && . ./.env.mcp && set +a
#
# .env.mcp is gitignored. Never commit real values.
# A token committed to git is compromised even after deletion — rotate it.

# Perplexity — https://console.perplexity.ai
PERPLEXITY_API_KEY=

# Apify — only for the LOCAL stdio variant.
# The hosted server declared in .mcp.json uses OAuth and needs no token.
# APIFY_TOKEN=

# Playwright  — no credential.
# Higgsfield  — OAuth, no credential.
# Buffer      — OAuth, and deliberately NOT in .mcp.json. See docs/mcp/02-setup-guide.md.
